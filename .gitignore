# ===== Dependencies（依赖，不需要上传） =====
node_modules/
node_modules_old/
.pnpm-store/

# ===== Build outputs（构建产物，部署用 dist 由 CI 生成） =====
dist/
.output/
.build/
.astro/

# ===== Wrangler / Cloudflare（部署相关本地状态） =====
.wrangler/
.cloudflare/
.dev.vars
.dev.vars.*

# ===== Environment variables（密钥不要上传） =====
.env
.env.*
!.env.example

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== OS generated files =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===== Editor directories and files =====
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ===== TypeScript / tooling cache =====
*.tsbuildinfo
.eslintcache
.stylelintcache

# ===== Testing / coverage =====
coverage/
.nyc_output/

# ===== Temporary files =====
*.tmp
*.temp
.cache/
tmp-*.mjs
tmp-*.js

# ===== Service worker（由构建生成，不手写上传） =====
/sw.js
/sw.js.map
