---
interface Props { label: string; value: string; }
const { label, value } = Astro.props;
---
<div class="rounded-3xl border border-[rgba(105,63,40,.18)] bg-white/68 p-5">
  <p class="text-xs font-black uppercase tracking-[.18em] text-[var(--red)]">{label}</p>
  <p class="mt-3 text-sm leading-7 text-[var(--wood)]">{value}</p>
</div>
