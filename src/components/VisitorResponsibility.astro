---
import SectionHeader from '@components/SectionHeader.astro';
import { responsibilities as itemsJa } from '@data/content';
import { responsibilities as itemsEn } from '@data/content.en';
import { t, type Lang } from '@i18n/index';

interface Props {
  lang?: Lang;
}
const { lang = 'ja' } = Astro.props;
const dict = t(lang).respect;
const responsibilities = lang === 'en' ? itemsEn : itemsJa;
---

<section class="container-page pb-20">
  <div class="grid gap-10 rounded-[2rem] bg-[rgba(63,40,27,.97)] p-8 text-[#fff8ea] md:p-10 lg:grid-cols-[.8fr_1.2fr]">
    <div>
      <p class="text-xs font-black uppercase tracking-[.22em] text-[#f6c96b]">{dict.eyebrow}</p>
      <h2 class="section-title mt-3 text-4xl font-black">{dict.title}</h2>
      <p class="mt-5 text-sm leading-8 text-[#f6ddb4]">{dict.lead}</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        responsibilities.map((r) => (
          <article class="rounded-[1.5rem] bg-white/8 p-5">
            <p class="text-2xl">{r.icon}</p>
            <h3 class="mt-2 font-serif text-xl font-bold">{r.title}</h3>
            <p class="mt-2 text-sm leading-7 text-[#f6ddb4]">{r.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
