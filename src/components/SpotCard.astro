---
import SaveButton from '@components/SaveButton.astro';
import type { TripItem } from '@data/content';
interface Props { item: TripItem; tone?: 'light' | 'wood'; }
const { item, tone = 'light' } = Astro.props;
---
<article class:list={['group overflow-hidden rounded-[1.7rem] border transition duration-200 hover:-translate-y-1', tone === 'wood' ? 'border-white/10 bg-white/8 text-[#fff8ea]' : 'paper-card']}>
  {item.image && <img src={item.image} alt={`${item.title}のイメージ`} width="900" height="640" loading="lazy" class="h-48 w-full object-cover transition duration-300 group-hover:scale-[1.02]" />}
  <div class="p-5">
    <div class="flex items-start justify-between gap-3">
      <p class:list={['rounded-full px-3 py-1 text-xs font-bold', tone === 'wood' ? 'bg-[#fff8ea]/12 text-[#f6ddb4]' : 'bg-[rgba(201,78,54,.1)] text-[var(--red)]']}>{item.category}</p>
      {item.time && <p class:list={['text-xs font-bold', tone === 'wood' ? 'text-[#f6ddb4]' : 'text-[var(--muted)]']}>{item.time}</p>}
    </div>
    <h3 class="mt-4 font-serif text-2xl font-bold tracking-[.04em]">{item.title}</h3>
    <p class:list={['mt-3 text-sm leading-7', tone === 'wood' ? 'text-[#f6ddb4]' : 'text-[var(--muted)]']}>{item.note}</p>
    <div class="mt-5">
      <SaveButton id={item.id} title={item.title} category={item.category} note={item.note} time={item.time} image={item.image} compact />
    </div>
  </div>
</article>
