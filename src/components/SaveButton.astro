---
interface Props {
  id: string;
  title: string;
  category: string;
  note: string;
  time?: string | undefined;
  image?: string | undefined;
  compact?: boolean;
}
const { id, title, category, note, time, image, compact = false } = Astro.props;
---
<button
  type="button"
  class:list={[
    'js-save-spot inline-flex items-center justify-center gap-2 rounded-full border border-[rgba(105,63,40,.26)] bg-white/78 font-bold text-[var(--wood)] transition hover:border-[rgba(185,71,50,.5)] hover:bg-white',
    compact ? 'px-3 py-1.5 text-xs' : 'px-4 py-2 text-sm',
  ]}
  data-id={id}
  data-title={title}
  data-category={category}
  data-note={note}
  data-time={time ?? ''}
  data-image={image ?? ''}
  aria-pressed="false"
>
  <span data-save-icon aria-hidden="true">＋</span><span data-save-label>旅リストに追加</span>
</button>
