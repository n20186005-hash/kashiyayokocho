---
import SectionHeader from '@components/SectionHeader.astro';
import { site } from '@config/site';
import { googleRating as ratingJa, sources as sourcesJa } from '@data/content';
import { googleRating as ratingEn, sources as sourcesEn } from '@data/content.en';
import { siteText } from '@i18n/site';
import { t, type Lang } from '@i18n/index';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}
const { title, description, lang = 'ja' } = Astro.props;
const dict = t(lang).sources;
const st = siteText(lang);
const googleRating = lang === 'en' ? ratingEn : ratingJa;
const sources = lang === 'en' ? sourcesEn : sourcesJa;

const heading = title ?? dict.title;
const lead = description ?? dict.description;
const summary =
  lang === 'en'
    ? `The ${googleRating.value} / ${googleRating.best} rating (${googleRating.countLabel} ratings) is synced from ${googleRating.sourceName} user ratings. ${googleRating.note} This guide is unofficial and is not the official site of ${st.attractionName}, its shops, or the local authorities.`
    : `評価 ${googleRating.value} / ${googleRating.best}（${googleRating.countLabel}件）は ${googleRating.sourceName} のユーザー評価を同期したものです。${googleRating.note} 本サイトは ${st.attractionName} および各店舗・自治体の公式サイトではない非公式ガイドです。`;
---

<section class="container-page pb-20">
  <SectionHeader eyebrow="SOURCES" title={heading} description={lead} />
  <div class="grid gap-4 md:grid-cols-2">
    {sources.map((item) => (
      <article class="paper-card rounded-[1.5rem] p-5">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-[rgba(201,78,54,.1)] px-3 py-1 text-xs font-bold text-[var(--red)]">{item.kind}</span>
          <span class="text-xs font-bold text-[var(--muted)]">{dict.syncedAt}{item.syncedAt}</span>
        </div>
        <h3 class="mt-3 font-serif text-xl font-bold text-[var(--wood)]">{item.title}</h3>
        <p class="mt-2 text-sm leading-7 text-[var(--muted)]">{item.memo}</p>
        <a
          class="mt-3 inline-flex text-sm font-bold text-[var(--red)] underline decoration-dotted underline-offset-4"
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {item.linkLabel}↗
        </a>
      </article>
    ))}
  </div>

  <div class="mt-6 rounded-[1.5rem] border border-[rgba(105,63,40,.18)] bg-white/70 p-5">
    <p class="text-sm font-bold text-[var(--wood)]">
      {dict.ratingSynced} {googleRating.syncedAt}
    </p>
    <p class="mt-2 text-sm leading-7 text-[var(--muted)]">{summary}</p>
    <div class="mt-4 flex flex-wrap gap-3">
      <a class="btn-secondary" href={googleRating.sourceUrl} target="_blank" rel="noopener noreferrer">
        {t(lang).rating.viewAllShort}↗
      </a>
      <a class="btn-secondary" href={site.officialUrl} target="_blank" rel="noopener noreferrer">{t(lang).common.officialSite}↗</a>
      <a class="btn-secondary" href={site.govtTourismUrl} target="_blank" rel="noopener noreferrer">{st.govtTourismName}↗</a>
      <a class="btn-secondary" href={lang === 'en' ? '/en/credits/' : '/credits/'}>{dict.creditsLink}</a>
    </div>
  </div>
</section>
