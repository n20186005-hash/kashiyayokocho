---
import { site } from '@config/site';
---
<div class="map-frame paper-card rounded-[1.8rem] p-2">
  <iframe
    src={site.mapEmbedUrl}
    width="600"
    height="450"
    style="border:0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    title="菓子屋横丁 Google マップ"
  ></iframe>
</div>
