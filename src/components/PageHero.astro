---
import { t, withLang, type Lang } from '@i18n/index';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  compact?: boolean;
  lang?: Lang;
}
const {
  title,
  description,
  image = '/images/kashiya-hero.webp',
  imageAlt,
  compact = false,
  lang = 'ja',
} = Astro.props;
const dict = t(lang);
const alt = imageAlt ?? dict.hero.defaultAlt;
---

<section class:list={['container-page grid items-center gap-8 pt-10 lg:grid-cols-[1.02fr_.98fr]', compact ? 'pb-10' : 'pb-16 lg:pt-16']}>
  <div>
    <h1 class="section-title text-balance text-4xl font-black leading-[1.14] text-[var(--wood)] md:text-6xl">{title}</h1>
    <p class="mt-6 max-w-2xl text-base leading-8 text-[var(--muted)] md:text-lg">{description}</p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={withLang('/access/', lang)} class="btn-primary">{dict.hero.ctaAccess}</a>
      <a href="/memory-card/" class="btn-secondary">{dict.hero.ctaCard}</a>
    </div>
  </div>
  <div class="relative">
    <div class="absolute -left-4 -top-4 h-24 w-24 rounded-full bg-[rgba(201,78,54,.16)] blur-2xl"></div>
    <figure class="overflow-hidden rounded-[2rem] border border-[rgba(105,63,40,.18)] bg-white p-2 shadow-2xl shadow-[rgba(63,40,27,.18)]">
      <img
        src={image}
        alt={alt}
        width="1600"
        height="1065"
        loading={compact ? 'lazy' : 'eager'}
        fetchpriority={compact ? 'auto' : 'high'}
        class="aspect-[4/3] w-full rounded-[1.55rem] object-cover"
      />
    </figure>
  </div>
</section>
