---
import Layout from '@layouts/Layout.astro';
import PageHero from '@components/PageHero.astro';
import SectionHeader from '@components/SectionHeader.astro';
import InfoPill from '@components/InfoPill.astro';
import SpotCard from '@components/SpotCard.astro';
import GoogleMap from '@components/GoogleMap.astro';
import GoogleRating from '@components/GoogleRating.astro';
import SourcesSection from '@components/SourcesSection.astro';
import SaveButton from '@components/SaveButton.astro';
import { site } from '@config/site';
import { buildStructuredData, foods, highlights, nearbySpots, visitFacts, faq, modelPlans, googleRating } from '@data/content';

const title = `${site.attractionName}（${site.city}）｜観光ガイド・場所・アクセス・周辺スポット`;
const description = `${site.region}${site.city}元町の${site.attractionName}（${site.attractionLatinName}）の観光ガイド。Google マップのユーザー評価 ${googleRating.value} / 5（${googleRating.countLabel}件・同期時期 ${googleRating.syncedAt}）、所在地、営業時間、行き方、周辺の${site.nearbyLandmarks[0]}・${site.nearbyLandmarks[1]}、周辺グルメ、FAQをまとめています。`;
const structuredData = buildStructuredData('/', title, description, [
  { name: 'ホーム', path: '/' },
  { name: site.region },
  { name: site.city },
  { name: site.attractionName },
]);
const entityChain = [site.attractionName, site.city, site.region, site.country];
---
<Layout title={title} description={description} structuredData={structuredData}>
  <PageHero
    title={`${site.attractionName}（${site.city}）`}
    description={site.entityLead}
    image={site.heroImage}
    imageAlt={`${site.attractionName} - ${site.city}・${site.country}の石畳と店先の風景`}
  />

  <section class="container-page pb-4">
    <nav aria-label="所在地の階層" class="flex flex-wrap items-center gap-2 text-sm">
      {entityChain.map((item, index) => (
        <span class="flex items-center gap-2">
          {index > 0 && <span class="text-[rgba(105,63,40,.4)]">›</span>}
          <span class={index === 0 ? 'font-bold text-[var(--wood)]' : 'text-[var(--muted)]'}>{item}</span>
        </span>
      ))}
    </nav>
  </section>

  <section class="container-page grid gap-6 pb-16 lg:grid-cols-[1.05fr_.95fr]">
    <GoogleRating />
    <div class="paper-card rounded-[1.8rem] p-6 md:p-8">
      <p class="text-xs font-black uppercase tracking-[.22em] text-[var(--red)]">LOCATION</p>
      <h2 class="mt-2 font-serif text-3xl font-bold text-[var(--wood)] md:text-4xl">{site.attractionName}の場所（{site.city}・{site.region}）</h2>
      <dl class="mt-5 grid gap-3 text-sm leading-7">
        <div class="rounded-2xl bg-white/70 p-4">
          <dt class="font-bold text-[var(--wood)]">住所</dt>
          <dd class="text-[var(--muted)]">{site.address.full}</dd>
        </div>
        <div class="rounded-2xl bg-white/70 p-4">
          <dt class="font-bold text-[var(--wood)]">座標</dt>
          <dd class="text-[var(--muted)]">{site.latitude}, {site.longitude}</dd>
        </div>
        <div class="rounded-2xl bg-white/70 p-4">
          <dt class="font-bold text-[var(--wood)]">カテゴリ</dt>
          <dd class="text-[var(--muted)]">観光地・商店街（入場無料・買物は店舗ごと）</dd>
        </div>
      </dl>
      <div class="mt-5 flex flex-wrap gap-3">
        <SaveButton id="kashiya-yokocho" title={site.attractionName} category="メイン" note="飴・せんべい・だんご・芋菓子を少しずつ。" />
        <a href="/access/" class="btn-secondary">行き方・駐車場</a>
        <a class="btn-secondary" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer">Google マップで開く↗</a>
      </div>
    </div>
  </section>

  <section class="container-page pb-16">
    <SectionHeader
      eyebrow="ABOUT"
      title={`${site.attractionName}（${site.city}）について`}
      description={`正式名称・通称ともに「${site.attractionName}」です。${site.region}${site.city}の蔵造りの町並みの北側に位置し、${site.nearbyLandmarks[0]}から徒歩約4分。飴、せんべい、だんご、芋菓子、駄菓子の店が石畳の細い路地に並び、${site.city}観光の回遊拠点として歩かれています。`}
    />
    <div class="grid gap-4 md:grid-cols-3">
      {highlights.map((item) => (
        <article class="paper-card kashi-pattern rounded-[1.7rem] p-6">
          <h3 class="font-serif text-2xl font-bold text-[var(--wood)]">{item.title}</h3>
          <p class="mt-4 text-sm leading-7 text-[var(--muted)]">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container-page grid gap-10 pb-20 lg:grid-cols-[.9fr_1.1fr]">
    <div>
      <SectionHeader eyebrow="BASIC" title="訪問前に知りたいこと" description="全体は小さな横丁ですが、店ごとの営業時間や休みが違います。目当ての店がある場合は直前確認がおすすめです。" />
      <div class="flex flex-wrap gap-3">
        <SaveButton id="kashiya-yokocho" title="菓子屋横丁" category="メイン" note="飴・せんべい・だんご・芋菓子を少しずつ。" />
        <a href="/plan/" class="btn-secondary">保存リストを見る</a>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {visitFacts.map((fact) => <InfoPill label={fact.label} value={fact.value} />)}
    </div>
  </section>

  <section class="bg-[rgba(63,40,27,.96)] py-20 text-[#fff8ea]">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[.78fr_1.22fr]">
        <div>
          <p class="text-xs font-black uppercase tracking-[.22em] text-[#f6c96b]">MODEL COURSE</p>
          <h2 class="section-title mt-2 text-4xl font-black md:text-5xl">おすすめの回り方</h2>
          <p class="mt-5 text-sm leading-8 text-[#f6ddb4]">短時間でも十分楽しい場所ですが、川越らしさを味わうなら「菓子屋横丁＋時の鐘＋蔵造りの町並み」をひとつの線で歩くのが自然です。</p>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {modelPlans.map((plan) => (
            <article class="rounded-[1.6rem] border border-white/12 bg-white/8 p-5">
              <h3 class="font-serif text-2xl font-bold">{plan.title}</h3>
              <ol class="mt-5 grid gap-3 text-sm leading-6 text-[#f6ddb4]">
                {plan.points.map((point, index) => <li><span class="mr-2 font-bold text-[#f6c96b]">{index + 1}.</span>{point}</li>)}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-20">
    <SectionHeader eyebrow="FOOD" title="周辺グルメ" description="菓子屋横丁では甘いものを少しずつ。ランチや休憩は周辺のパン、ベーグル、うなぎ、和食を組み合わせると満足度が上がります。" />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {foods.slice(0, 3).map((item) => <SpotCard item={item} />)}
    </div>
    <div class="mt-8"><a href="/food/" class="btn-primary">周辺グルメをもっと見る</a></div>
  </section>

  <section class="container-page pb-20">
    <SectionHeader eyebrow="AROUND" title={`${site.attractionName}の周辺スポット`} description="川越の定番スポットは徒歩圏にまとまっています。混雑日は早い時間に横丁、昼前後に周辺スポットへ回ると歩きやすいです。" />
    <p class="mb-8 max-w-3xl text-sm leading-8 text-[var(--muted)]">
      {site.attractionName}を訪れる際は、周辺の歴史的なランドマークや観光スポットへも徒歩でそのまま回れます。とくに<strong class="font-bold text-[var(--wood)]">{site.nearbyLandmarks[0]}</strong>と<strong class="font-bold text-[var(--wood)]">{site.nearbyLandmarks[1]}</strong>は横丁から近く、{site.city}らしい町並みの写真を撮るのに向いています。
    </p>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {nearbySpots.slice(0, 3).map((item) => <SpotCard item={item} />)}
    </div>
    <div class="mt-8"><a href="/nearby/" class="btn-secondary">周辺スポットを確認</a></div>
  </section>

  <section class="container-page pb-20">
    <SectionHeader
      eyebrow="HISTORY"
      title={`${site.attractionName}の歴史と意味`}
      description={`${site.city}の菓子屋横丁がいつからあるのか、なぜ甘い香りの路地になったのかを、川越市・観光協会の案内をもとに整理しました。`}
    />
    <div class="grid gap-4 md:grid-cols-3">
      <article class="paper-card rounded-[1.7rem] p-6">
        <h3 class="font-serif text-2xl font-bold text-[var(--wood)]">大正期に菓子職人が集まった路地</h3>
        <p class="mt-4 text-sm leading-7 text-[var(--muted)]">関東大震災を機に東京の菓子職人や菓子問屋が川越へ移り、駄菓子や飴を作って売ったことが、横丁のはじまりとして伝えられています。学校帰りの子どもが立ち寄る駄菓子屋の記憶とともに育った路地です。</p>
      </article>
      <article class="paper-card rounded-[1.7rem] p-6">
        <h3 class="font-serif text-2xl font-bold text-[var(--wood)]">平成13年「かおり風景100選」</h3>
        <p class="mt-4 text-sm leading-7 text-[var(--muted)]">醤油の焼ける香り、ニッキやハッカ飴の甘い匂いが評価され、環境庁（当時）の「かおり風景100選」に選ばれました。「香りで記憶される横丁」として紹介される理由です。</p>
      </article>
      <article class="paper-card rounded-[1.7rem] p-6">
        <h3 class="font-serif text-2xl font-bold text-[var(--wood)]">今も続く石畳と店先</h3>
        <p class="mt-4 text-sm leading-7 text-[var(--muted)]">現在は約30軒程度の菓子店が並び、石畳の細い路地に店先が並ぶ景観が残ります。蔵造りの町並みや時の鐘とあわせて歩くことで、小江戸川越の町歩きの一部として楽しめます。</p>
      </article>
    </div>
    <p class="mt-6 text-xs leading-6 text-[var(--muted)]">
      歴史・選定・店舗数は川越市・小江戸川越観光協会の公開情報をもとに整理しています（出典は<a class="font-bold text-[var(--red)] underline decoration-dotted underline-offset-4" href={site.cityTourismUrl} target="_blank" rel="noopener noreferrer">川越市のページ↗</a>・<a class="font-bold text-[var(--red)] underline decoration-dotted underline-offset-4" href={site.govtTourismUrl} target="_blank" rel="noopener noreferrer">{site.govtTourismName}↗</a>）。
    </p>
  </section>

  <section class="container-page grid gap-8 pb-20 lg:grid-cols-[.9fr_1.1fr]">
    <div>
      <SectionHeader eyebrow="MAP" title={`${site.attractionName}の場所と行き方（${site.city}）`} description="埋め込み地図は日本語・日本地域パラメータに変更済みです。現地では路地が細いので、徒歩ナビの到着点を見ながら入り口を探すと安心です。" />
      <div class="rounded-3xl bg-[rgba(201,78,54,.09)] p-5 text-sm leading-7 text-[var(--muted)]">
        <p class="font-bold text-[var(--wood)]">住所</p>
        <p class="mt-1">{site.address.full}</p>
        <p class="mt-4 font-bold text-[var(--wood)]">座標</p>
        <p class="mt-1">{site.latitude}, {site.longitude}</p>
      </div>
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn-secondary" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer">Google マップで見る↗</a>
        <a class="btn-secondary" href={site.officialUrl} target="_blank" rel="noopener noreferrer">公式サイト↗</a>
        <a class="btn-secondary" href={site.govtTourismUrl} target="_blank" rel="noopener noreferrer">{site.govtTourismName}↗</a>
      </div>
    </div>
    <GoogleMap />
  </section>

  <section class="container-page pb-20">
    <SectionHeader eyebrow="FAQ" title="FAQ・よくある質問" description="営業時間、料金、駐車場、保存機能についてのよくある質問をまとめました。" />
    <div class="grid gap-4 md:grid-cols-2">
      {faq.slice(0, 4).map((item) => (
        <details class="paper-card rounded-3xl p-6">
          <summary class="cursor-pointer font-serif text-xl font-bold text-[var(--wood)]">{item.q}</summary>
          <p class="mt-4 text-sm leading-7 text-[var(--muted)]">{item.a}</p>
        </details>
      ))}
    </div>
    <div class="mt-8"><a href="/faq/" class="btn-secondary">FAQをすべて見る</a></div>
  </section>

  <SourcesSection
    title="情報の出典（資料来源）"
    description={`${site.attractionName}の評価・所在地・歴史・周辺情報は、Google マップのユーザー評価と公的機関・公式サイトの公開情報を組み合わせて整理しています。`}
  />
</Layout>
