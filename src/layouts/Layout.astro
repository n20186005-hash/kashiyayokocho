---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { absoluteUrl, site } from '@config/site';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: unknown;
  noindex?: boolean;
}

const {
  title = site.name,
  description = site.description,
  image = site.ogImage,
  structuredData,
  noindex = false,
} = Astro.props;
const canonical = site.url ? absoluteUrl(Astro.url.pathname) : undefined;
const pageTitle = title === site.name ? title : `${title}｜${site.shortName}`;
const ogImage = site.url ? absoluteUrl(image) : undefined;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f8ead0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4}`}></script>
    <script is:inline define:vars={{ ga4: site.ga4 }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ga4);
    </script>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '@scripts/trip-list.ts';
    </script>
  </body>
</html>
