---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { absoluteUrl, site } from '@config/site';
import { siteText } from '@i18n/site';
import { LANGUAGES, LANG_META, alternateHref, getLangFromPath, type Lang } from '@i18n/index';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  structuredData?: unknown;
  noindex?: boolean;
  lang?: Lang;
}

const {
  title = site.name,
  description = site.description,
  image = site.ogImage,
  imageAlt,
  structuredData,
  noindex = false,
  lang,
} = Astro.props;

const current: Lang = lang ?? getLangFromPath(Astro.url.pathname);
const st = siteText(current);
const htmlLang = LANG_META[current].htmlLang;
const canonical = site.url ? absoluteUrl(Astro.url.pathname) : undefined;
const resolvedTitle = title === site.name ? st.name : title;
const pageTitle =
  resolvedTitle === st.name || resolvedTitle.includes(st.shortName)
    ? resolvedTitle
    : `${resolvedTitle}｜${st.shortName}`;
const ogImage = site.url ? absoluteUrl(image) : undefined;
const resolvedAlt = imageAlt ?? (current === 'en' ? st.tagline : `${site.attractionName}（${site.city}）の石畳と店先の風景`);

// 多言語ページ同士を hreflang で結びつける（404 など索引対象外では出さない）。
const alternates = noindex
  ? []
  : LANGUAGES.map((code) => ({
      hreflang: code,
      href: absoluteUrl(alternateHref(Astro.url.pathname, code)),
    }));
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternateHref(Astro.url.pathname, 'ja'))} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:locale" content={LANG_META[current].ogLocale} />
    <meta property="og:site_name" content={st.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={resolvedAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <meta name="twitter:url" content={canonical} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={resolvedAlt} />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={st.shortName} />
    <meta name="application-name" content={st.shortName} />
    <meta name="geo.region" content="JP-11" />
    <meta name="geo.placename" content={`${site.region}${site.city}`} />
    <meta name="geo.position" content={`${site.latitude};${site.longitude}`} />
    <meta name="ICBM" content={`${site.latitude}, ${site.longitude}`} />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4}`}></script>
    <script is:inline define:vars={{ ga4: site.ga4 }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ga4);
    </script>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <Header lang={current} />
    <main>
      <slot />
    </main>
    <Footer lang={current} />
    <script>
      import '@scripts/trip-list.ts';
    </script>
    {
      import.meta.env.PROD && (
        <script is:inline>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
              navigator.serviceWorker.register('/sw.js').catch(function () {});
            });
          }
        </script>
      )
    }
  </body>
</html>
